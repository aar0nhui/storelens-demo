// Private StoreLens app: the dashboard (static assets) + /ingest + /data, ALL behind Cloudflare Access.
// Deploy from this folder (`npx wrangler deploy`), never from the repo root: the root wrangler.jsonc is the PUBLIC demo.
// Variables below are not secret. See README.md for the Access applications and the R2 bucket this needs.
{
  "name": "storelens-app",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every request, including static files, goes through the Worker so the Access JWT is always checked.
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "storelens-snapshots" }],
  "vars": {
    "STORE_ID": "REPLACE_ME",
    "TEAM_DOMAIN": "https://REPLACE_ME.cloudflareaccess.com",
    "APP_AUD": "REPLACE_WITH_AUD_TAG_OF_THE_DASHBOARD_ACCESS_APP",
    "INGEST_AUD": "REPLACE_WITH_AUD_TAG_OF_THE_INGEST_ACCESS_APP",
    "ALLOWED_EMAILS": "owner@example.com",
    "INGEST_CLIENT_IDS": "REPLACE_WITH_SERVICE_TOKEN_CLIENT_ID.access"
  },
  "observability": { "enabled": true }
}
